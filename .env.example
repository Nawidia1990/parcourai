# Copy to .env.local (setup.cmd creates it for you). Never commit .env.local.
# Names must match exactly. For the live site, add the same names in Vercel > Settings > Environment Variables (Production), then redeploy.

# AI generation (required for CV, letters, assistants)
ANTHROPIC_API_KEY=

# Firebase Admin (sign-in checks, staff tools, live job search) - base64 of the service-account .json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...): 3 tiers x monthly/annual. Prices to create in Stripe (USD, recurring):
#   Essential $15.99/month or $159.90/year, Pro $25.99/month or $259.90/year, Premium $35.99/month or $359.90/year
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=

# Live job search (optional; remote boards need no key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JSEARCH_API_KEY=
# rapidapi if the JSearch key comes from rapidapi.com; leave empty for OpenWeb Ninja
JSEARCH_PROVIDER=rapidapi
# Only if the default endpoint or header does not work
JSEARCH_API_URL=
JSEARCH_AUTH_HEADER=

# Staff area: the owner's email(s), comma-separated. Signing in at /staff-login with one of them makes it an admin.
ADMIN_EMAILS=
# Optional: send staff messages by email too (resend.com)
RESEND_API_KEY=
RESEND_FROM=

# --- Send email from the app (Gmail / Outlook) ---
# Any long random string; encrypts the stored mail tokens. Generate: openssl rand -base64 32
MAIL_ENC_KEY=
# Google Cloud > APIs & Services > Credentials > OAuth client (Web). Redirect URI: https://www.parcourai.com/api/mail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Azure > App registrations (Web, accounts in any org + personal). Redirect URI: https://www.parcourai.com/api/mail
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# Public site URL used to build the redirect URI (no trailing slash)
APP_URL=https://www.parcourai.com
